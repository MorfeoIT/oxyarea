{
    "name": "oxysoft/oxyarea",
    "description": "Private client areas and user portals for WordPress: frontend login, roles, role dashboards, redirects and content restriction.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "homepage": "https://oxywp.com/oxyarea/",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpstan/phpstan": "^2.2",
        "php-stubs/wordpress-stubs": "^6.5"
    },
    "autoload": {
        "psr-4": {
            "OxyArea\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OxyArea\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test:all": "phpunit",
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "analyse": "phpstan analyse",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "optimize-autoloader": true
    },
    "minimum-stability": "stable"
}
