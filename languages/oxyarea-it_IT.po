#. Description of the plugin
#: oxyarea.php
msgid "Build a complete private client area in WordPress: frontend login, roles, role dashboards, post-login redirects and content restriction, without assembling five plugins."
msgstr "Costruisci in WordPress un'area clienti privata completa: accesso dal sito, ruoli, bacheche per ruolo, destinazioni dopo l'accesso e contenuti riservati, senza mettere insieme cinque plugin."

#. Author of the plugin
#: oxyarea.php
msgid "Oxysoft"
msgstr ""

#. Author URI of the plugin
